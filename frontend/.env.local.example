# ─── Frontend Environment Variables ──────────────────────────────────────────
# Copy this file as .env.local and fill in your values.
# .env.local is gitignored — never commit real keys.

# Backend API URL (your Express server)
NEXT_PUBLIC_API_URL=http://localhost:5000

# Razorpay PUBLIC key only — this is the key_id (starts with rzp_test_ or rzp_live_)
# Safe to expose to the browser. Get it from: https://dashboard.razorpay.com/app/keys
# ⚠️ NEVER put the Key Secret here — it stays in the backend .env ONLY
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
