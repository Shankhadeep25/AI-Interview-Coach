# ─── Backend Environment Variables ───────────────────────────────────────────
# Copy this file as .env and fill in your real values.
# .env is gitignored — never commit real keys.

# Server port
PORT=5000

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/ai-interview-coach

# JWT secret for signing auth tokens — use a long random string
JWT_SECRET=your_super_secret_jwt_key_change_this

# Google Gemini API key — get from https://aistudio.google.com
GEMINI_API_KEY=get_from_aistudio.google.com

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:3000

# Environment
NODE_ENV=development

# Cookie name for httpOnly JWT token
COOKIE_NAME=aic_token

# Nodemailer — Gmail credentials for contact form emails
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_char_app_password

# Razorpay — Get both keys from: https://dashboard.razorpay.com/app/keys
# key_id is PUBLIC (also goes in frontend .env.local as NEXT_PUBLIC_RAZORPAY_KEY_ID)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
# key_secret is PRIVATE — NEVER share this, NEVER put in frontend code
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
